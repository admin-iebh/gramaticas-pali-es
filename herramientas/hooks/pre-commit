#!/bin/sh
# Antes de cada commit: (1) convierte los maestros de docs/ al formato del
# generador —todos los herramientas/convertir_*.py— y (2) regenera el sitio,
# para que ni los archivos del generador ni el HTML publicado se queden atrás
# del markdown.
# Instalar con: herramientas/instalar-hooks.sh

RAIZ=$(git rev-parse --show-toplevel)

PY=$(command -v python3 || command -v python)
if [ -z "$PY" ]; then
  echo "pre-commit: no encuentro python3; el sitio NO se ha regenerado."
  echo "            Instálalo o regenera a mano antes de publicar."
  exit 0
fi

for SCRIPT in "$RAIZ"/herramientas/convertir_*.py; do
  [ -e "$SCRIPT" ] || continue
  CONV=$(cd "$RAIZ" && "$PY" "$SCRIPT" 2>&1)
  if [ $? -ne 0 ]; then
    echo "$CONV"
    echo "pre-commit: $(basename "$SCRIPT") ha fallado (el maestro y el archivo"
    echo "            del generador no cuadran); commit detenido."
    exit 1
  fi
done

SALIDA=$("$PY" "$RAIZ/herramientas/generar_todo.py" 2>&1)
if [ $? -ne 0 ]; then
  echo "$SALIDA"
  echo "pre-commit: la generación ha fallado; commit detenido."
  exit 1
fi

CAMBIOS=$(cd "$RAIZ" && git diff --name-only -- site/ kaccayana/)
if [ -n "$CAMBIOS" ]; then
  echo "pre-commit: regenerado y añadido al commit:"
  echo "$CAMBIOS" | sed 's/^/    /'
  (cd "$RAIZ" && echo "$CAMBIOS" | tr '\n' '\0' | xargs -0 git add)
fi

echo "$SALIDA" | grep -E "aviso|Referencias §N" && \
  echo "pre-commit: revisa los avisos de arriba."

exit 0
